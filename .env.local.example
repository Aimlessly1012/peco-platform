# ── 数据库（与 RAG 后端共用同一个 Postgres）────────────────────────────
# 本地开发指向 RAG 的 compose 里那个库；表名用 platform_users，不与 M8 的 users 冲突
DATABASE_URL=postgres://raguser:ragpass@localhost:5433/ragcoder

# ── NextAuth ──────────────────────────────────────────────────────────
# 站点地址；生产改成真实域名（OAuth 回调要对得上）
NEXTAUTH_URL=http://localhost:3000
# 会话签名密钥，用 `openssl rand -base64 32` 生成，别用示例值
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# ── GitHub OAuth App ──────────────────────────────────────────────────
# 去 https://github.com/settings/developers 新建 OAuth App：
#   Homepage URL         http://localhost:3000
#   Authorization callback URL  http://localhost:3000/api/auth/callback/github
# 生产环境把 localhost:3000 换成真实域名，回调地址必须逐字一致
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# ── 管理员 ────────────────────────────────────────────────────────────
# 你的 GitHub 数字 id（不是用户名）。取法：curl -s https://api.github.com/users/<你的用户名> | grep '"id"'
# 这个账号首次登录直接是 admin + approved，不用等审核；其他人一律 pending
ADMIN_GITHUB_ID=
