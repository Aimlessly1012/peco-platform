# ===== 数据库（compose 内已注入，本地直跑后端时取消注释）=====
# DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5433/ragcoder
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragcoder123

# ===== 硅基流动成套配置（M7 生产推荐）=====
# 三处 API key 填同一个硅基流动 key 即可。
# base_url 一律写到 /v1 为止、不带资源后缀：嵌入由 OpenAI SDK 拼 /embeddings，
# 重排由本项目的客户端拼 /rerank。
#
# ⚠️ 换嵌入模型 = 换向量维度（1024 → 4096），启动时会被维度校验拒绝。
#    已有数据的实例请按 deploy/DEPLOY.md 附录先删三个向量索引再重索引。

# ===== 嵌入模型（OpenAI 兼容；生产用硅基流动，本地可切 Ollama 零成本）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-siliconflow-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
# 4096 是该模型的原生维度，质量最优。它也支持 MRL 降维（请求带 dimensions:1024 等），
# 想省 Neo4j 内存可以走那条路——但本项目当前不下发 dimensions 参数，改维度需同步改代码
# 单次嵌入调用超时（秒）。云端 30 足够；本地 Ollama 首字慢，给到 120
EMBEDDING_TIMEOUT_SECONDS=30
# 本地 Ollama 备选（容器内用 host.docker.internal，本地直跑用 localhost:11434）：
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_TIMEOUT_SECONDS=120

# ===== 聊天模型（OpenAI 兼容）=====
# 硅基流动:  CHAT_BASE_URL=https://api.siliconflow.cn/v1   CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# DeepSeek:  CHAT_BASE_URL=https://api.deepseek.com         CHAT_MODEL=deepseek-v4-flash
# DashScope: CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  CHAT_MODEL=qwen3.7-plus
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_API_KEY=your-siliconflow-key
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 单次 LLM 调用超时（秒，默认 60）。超时按既有退避重试，最终失败降级占位
LLM_TIMEOUT_SECONDS=60

# ===== 重排模型（M7 D2，检索精排；留空 = 关闭，行为与 M6 一致）=====
# RRF 融合出候选池（top_k × 3）后送重排取 top_k，再做图扩展。
# 三项任一为空即完全关闭；调用超时(5s)/失败/坏响应自动降级为 RRF 顺序，不影响问答。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=your-siliconflow-key
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# ===== 子路径部署（M7 D3；本机开发全部留空）=====
# 生产经 Nginx 子路径 /rag 时：后端 ROOT_PATH=/rag/api（只影响 openapi 地址生成），
# 前端构建期注入 NEXT_PUBLIC_BASE_PATH=/rag 与 NEXT_PUBLIC_API_BASE=/rag/api。
# 这些值在 docker-compose.prod.yml 里已配好，通常不用在 .env 里写。
# ROOT_PATH=

# ===== 安全 =====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# MCP 鉴权：留空 = 本地免鉴权（默认）。非空时 /mcp 需要 Authorization: Bearer <token>
# 客户端：claude mcp add --transport http rag-coder <url> --header "Authorization: Bearer <token>"
# MCP_AUTH_TOKEN=
# MCP 的 DNS 重绑定防护白名单（JSON 数组）。MCP 无鉴权时这是唯一屏障，勿随意放开
# MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*","backend:*"]

# ===== 其他 =====
# REPOS_DIR=./data/repos
# RETRIEVAL_TOP_K=8
