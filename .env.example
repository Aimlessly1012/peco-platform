# ===== 数据库（compose 内已注入，本地直跑后端时取消注释）=====
# DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5433/ragcoder
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragcoder123

# ===== 嵌入模型（OpenAI 兼容；默认云端 DashScope，机器强可切本地 Ollama 零成本）=====
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-dashscope-key
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIM=1024
# 单次嵌入调用超时（秒）。云端 30 足够；本地 Ollama 首字慢，给到 120
EMBEDDING_TIMEOUT_SECONDS=30
# 本地 Ollama 备选（容器内用 host.docker.internal，本地直跑用 localhost:11434）：
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_TIMEOUT_SECONDS=120

# ===== 聊天模型（OpenAI 兼容）=====
# DeepSeek:   CHAT_BASE_URL=https://api.deepseek.com          CHAT_MODEL=deepseek-v4-flash
# DashScope:  CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  CHAT_MODEL=qwen3.7-plus
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=your-chat-api-key
CHAT_MODEL=deepseek-v4-flash
# 单次 LLM 调用超时（秒，默认 60）。超时按既有退避重试，最终失败降级占位
LLM_TIMEOUT_SECONDS=60

# ===== 安全 =====
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# MCP 鉴权：留空 = 本地免鉴权（默认）。非空时 /mcp 需要 Authorization: Bearer <token>
# 客户端：claude mcp add --transport http rag-coder <url> --header "Authorization: Bearer <token>"
# MCP_AUTH_TOKEN=
# MCP 的 DNS 重绑定防护白名单（JSON 数组）。MCP 无鉴权时这是唯一屏障，勿随意放开
# MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*","backend:*"]

# ===== 其他 =====
# REPOS_DIR=./data/repos
# RETRIEVAL_TOP_K=8
