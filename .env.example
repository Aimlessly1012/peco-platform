# ===== 数据库（compose 内已注入，本地直跑后端时取消注释）=====
# DATABASE_URL=postgresql+asyncpg://raguser:ragpass@localhost:5433/ragcoder
# NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragcoder123

# ===== 硅基流动成套配置（M7 生产推荐）=====
# 三处 API key 填同一个硅基流动 key 即可。
# base_url 一律写到 /v1 为止、不带资源后缀：嵌入由 OpenAI SDK 拼 /embeddings，
# 重排由本项目的客户端拼 /rerank。
#
# ⚠️ 换嵌入模型 = 换向量维度（1024 → 4096），启动时会被维度校验拒绝。
#    已有数据的实例请按 deploy/DEPLOY.md 附录先删三个向量索引再重索引。

# ===== 嵌入模型（OpenAI 兼容；生产用硅基流动，本地可切 Ollama 零成本）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-siliconflow-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
# 4096 是该模型的原生维度，质量最优。它也支持 MRL 降维（请求带 dimensions:1024 等），
# 想省 Neo4j 内存可以走那条路——但本项目当前不下发 dimensions 参数，改维度需同步改代码
# 单次嵌入调用超时（秒）。云端 30 足够；本地 Ollama 首字慢，给到 120
EMBEDDING_TIMEOUT_SECONDS=30
# 本地 Ollama 备选（容器内用 host.docker.internal，本地直跑用 localhost:11434）：
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_TIMEOUT_SECONDS=120

# ===== 聊天模型（OpenAI 兼容）=====
# 硅基流动:  CHAT_BASE_URL=https://api.siliconflow.cn/v1   CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# DeepSeek:  CHAT_BASE_URL=https://api.deepseek.com         CHAT_MODEL=deepseek-v4-flash
# DashScope: CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  CHAT_MODEL=qwen3.7-plus
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_API_KEY=your-siliconflow-key
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 单次 LLM 调用超时（秒）。超时按既有退避重试，最终失败降级占位。
# 生产实测：报告件（文档章节/时序图/业务流程图）用推理型模型时单次要 40s+，
# 且 summary_concurrency 并发争抢会再拉长——60s 会反复超时重试并降级拼接，
# 表现为索引长时间卡在 report 92%。跨境访问或用推理型模型时给到 180
LLM_TIMEOUT_SECONDS=180

# --- 模型分工（M10 提速）：在线问答求快，离线产出求质量 ---
# CHAT_MODEL 走在线问答（理解/分类 + 答案生成）：推理型模型首字要十几秒，代码专用
# 非推理模型实测首字 0.9s、[n] 引用标注更规范，分类准确率实测持平（5/5）
# GENERATE_MODEL 只覆盖「答案生成」，留空则回落 CHAT_MODEL；想让理解与生成用不同模型时才填
GENERATE_MODEL=
# SUMMARY_MODEL 覆盖索引摘要（L2/L3/L4）与报告件生成：这两类是离线批处理，不赶时间，
# 用推理型模型结论更谨慎。留空则回落 CHAT_MODEL
SUMMARY_MODEL=
# 送进答案生成的资料总字符预算（0=不限）。rerank 已把最相关的排前面，砍尾部长尾省 prefill；
# 注意裁的是 items 列表本身，答案里的 [n] 上标与右栏引用才不会错位
CONTEXT_CHAR_BUDGET=9000

# ===== 重排模型（M7 D2，检索精排；留空 = 关闭，行为与 M6 一致）=====
# RRF 融合出候选池（top_k × 3）后送重排取 top_k，再做图扩展。
# 三项任一为空即完全关闭；调用超时(5s)/失败/坏响应自动降级为 RRF 顺序，不影响问答。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=your-siliconflow-key
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# ===== 子路径部署（M7 D3；本机开发全部留空）=====
# 生产经 Nginx 子路径 /rag 时：后端 ROOT_PATH=/rag/api（只影响 openapi 地址生成），
# 前端构建期注入 NEXT_PUBLIC_BASE_PATH=/rag 与 NEXT_PUBLIC_API_BASE=/rag/api。
# 这些值在 docker-compose.prod.yml 里已配好，通常不用在 .env 里写。
# ROOT_PATH=

# ===== 安全 =====
# ⚠️ SECRET_KEY 同时用于加密 git token 与签发登录态 JWT。
#    保持默认值 = 任何人都能伪造管理员登录态。生产必须换成 32+ 字节随机串：
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# ===== 管理员账号（M8）=====
# 首次启动时若库中没有管理员，用这组值创建；之后改这里不会覆盖已有账号
#（改密码请重新建号或直接改库）。ADMIN_PASSWORD 留空则不创建，系统能起但没人能登录。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-boot

# MCP 鉴权：留空 = 本地免鉴权（默认）。非空时 /mcp 需要 Authorization: Bearer <token>
# 客户端：claude mcp add --transport http rag-coder <url> --header "Authorization: Bearer <token>"
# MCP_AUTH_TOKEN=
# MCP 的 DNS 重绑定防护白名单（JSON 数组）。MCP 无鉴权时这是唯一屏障，勿随意放开
# MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*","backend:*"]

# ===== 任务队列（M13：Celery + RabbitMQ）=====
# false = 索引仍跑在 API 进程内（M12 行为）。这是生产回滚开关：出问题改回 false
# 重启 backend 即可，不必回退镜像。true 时索引由独立的 worker 容器执行。
TASK_QUEUE_ENABLED=false
# 用户名/密码要与 compose 里 rabbitmq 服务的 RABBITMQ_DEFAULT_USER/PASS 一致。
# 结尾的 // 是默认 vhost "/"，别删。
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_URL=amqp://rag:change-me-rabbitmq-password@rabbitmq:5672//
# 本地直跑后端时（不进容器）指向宿主映射端口：
# RABBITMQ_URL=amqp://rag:change-me-rabbitmq-password@localhost:5673//

# ===== 对象存储（M13：MinIO）=====
# 存两类非关键路径产物：理解报告导出件、索引解析产物快照。
# MINIO_ACCESS_KEY 留空 = 整个存储层 no-op（不装 MinIO 也能正常跑）。
# 这两个值同时也是 compose 里 MinIO 的 root 账号密码。
MINIO_ACCESS_KEY=ragminio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=rag-artifacts
MINIO_SECURE=false
# 本地直跑后端时：MINIO_ENDPOINT=localhost:9100

# ===== 其他 =====
# REPOS_DIR=./data/repos
# RETRIEVAL_TOP_K=8
