# ── 数据库：容器网络内直接用服务名 db（RAG compose 提供）────────────────
DATABASE_URL=postgres://raguser:ragpass@db:5432/ragcoder

# ── NextAuth ──────────────────────────────────────────────────────────
# 必须与公网访问地址一致，否则 OAuth 回调对不上
NEXTAUTH_URL=http://43.167.170.20
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ── GitHub OAuth App ──────────────────────────────────────────────────
# https://github.com/settings/developers 新建 OAuth App：
#   Homepage URL:              http://43.167.170.20
#   Authorization callback URL: http://43.167.170.20/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# 你的 GitHub 数字 ID（不是用户名）：curl https://api.github.com/users/<用户名> 取 id
# 这个账号首次登录即为 admin 且直接 approved，其余人一律 pending 等审核
ADMIN_GITHUB_ID=
